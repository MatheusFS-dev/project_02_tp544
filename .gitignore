# One project environment and transient Python state
.venv/
__pycache__/
.pytest_cache/
*.egg-info/

# Runtime weights, logs, local experiments and solver caches
src/air_only/results/
src/air_only/runs/
src/air_only/validation/**/logs/
src/air_only/validation/**/*.aedtresults/
src/air_only/validation/**/*.aedt.lock
src/air_only/validation/**/*.aedt.auto
src/air_only/validation/**/*.aedt.bak
src/air_only/data/processed/**/.lock
src/air_only/docs/plans/

# Archived large/runtime artifacts remain local, without deleting them
archive/inverse_design/results/
archive/inverse_design/runs/
archive/inverse_design/validation/**/logs/
archive/inverse_design/validation/**/*.aedtresults/
archive/inverse_design/validation/**/*.aedt.lock
archive/inverse_design/validation/**/*.aedt.auto
archive/inverse_design/validation/**/*.aedt.bak
archive/inverse_design/verification/
archive/inverse_design/docs/superpowers/
