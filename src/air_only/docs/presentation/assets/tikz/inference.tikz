\begin{tikzpicture}[font=\small,>=Latex,
  ttl/.style={draw=inatelblue,fill=inatelblue,text=white,rounded corners=2pt,minimum width=26mm,minimum height=17mm,align=center,font=\small\bfseries},
  dsc/.style={draw=inatelblue,fill=inatelblue!7,rounded corners=2pt,minimum width=78mm,minimum height=17mm,text width=74mm,align=left,inner xsep=3mm},
  arr/.style={->,very thick,inatelnavy}]
\node[ttl] (t1) {1. Pedido};
\node[dsc,right=2mm of t1] (d1) {Banda de comprimentos de onda $[\lambda_1,\lambda_2]$ e a absorção desejada $A_\star$.};
\node[ttl,below=3mm of t1] (t2) {2. Inícios};
\node[dsc,right=2mm of t2] (d2) {Em cada família, pegamos as 8 geometrias do treino (já simuladas no HFSS) cujo espectro mais se aproxima do pedido. Cada uma tem dimensões diferentes: 12 $\times$ 8 = 96 inícios.};
\node[ttl,below=3mm of t2] (t3) {3. Ajuste};
\node[dsc,right=2mm of t3] (d3) {500 passos: o modelo único recebe a família e as dimensões de cada um dos 96 inícios, prevê a absorção e mede o erro. Só as dimensões mudam, perto do início.};
\node[ttl,below=3mm of t3] (t4) {4. Escolha};
\node[dsc,right=2mm of t4] (d4) {Em cada família, fica a melhor geometria. Entre as 12, vence a de menor pior erro na banda (desempate: erro médio), salva em \texttt{geometry.json}.};
\foreach \a/\b in {t1/t2,t2/t3,t3/t4} \draw[arr] (\a)--(\b);
\end{tikzpicture}
